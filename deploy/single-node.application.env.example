# Application runtime only. Copy to deploy/single-node.application.env and chmod 600.
XINGTU_DATABASE_URL=postgresql://xingtu_app:CHANGE_ME_URL_ENCODED@app-postgres:5432/xingtu_production
XINGTU_DB_CONNECT_TIMEOUT_SECONDS=10
XINGTU_DB_TCP_USER_TIMEOUT_MS=10000
XINGTU_DB_SLOW_MS=1000
XINGTU_REDIS_URL=redis://:CHANGE_ME_URL_ENCODED@redis:6379/0
XINGTU_TEMPORAL_ADDRESS=temporal:7233
XINGTU_API_HOST=0.0.0.0
XINGTU_API_PORT=8000
XINGTU_FORWARDED_ALLOW_IPS=*
XINGTU_LOGIN_HMAC_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# Must be the exact browser origin, including the port, e.g. http://101.42.14.225:18080.
XINGTU_ALLOWED_ORIGINS=http://101.42.14.225:18080
# The baseline is served over plain HTTP on a non-standard port, so the session cookie must not be
# marked Secure.
XINGTU_SECURE_COOKIE=0
XINGTU_REGISTRY_PATH=/app/contracts/douyin_xingtu.verified.json
XINGTU_PROFILE_REQUIREMENT_PATH=/app/contracts/profile_requirements.json

DEEPSEEK_API_KEY=CHANGE_ME
XINGTU_DEEPSEEK_MODEL=deepseek-flash
XINGTU_DEEPSEEK_BASE_URL=https://api.deepseek.com

XINGTU_COVER_KIND=s3
XINGTU_S3_ENDPOINT=http://objects:9000
XINGTU_S3_COVER_BUCKET=xingtu-covers
AWS_ACCESS_KEY_ID=xingtu_worker
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SAME_AS_MINIO_WORKER_PASSWORD
AWS_DEFAULT_REGION=us-east-1

# The baseline has no remote viewer and no Mac-side takeover.
XINGTU_REMOTE_VIEWER_BASE_URL=
XINGTU_REMOTE_VNC_TARGETS_JSON={}
