# Store the populated copy outside Git and chmod 600.
XINGTU_DATABASE_URL=postgresql://xingtu_app:CHANGE_ME_URL_ENCODED@100.64.0.10:5432/xingtu_production
XINGTU_DB_CONNECT_TIMEOUT_SECONDS=10
XINGTU_DB_TCP_USER_TIMEOUT_MS=10000
# Log any single DB operation at/above this duration; 0 logs every operation.
XINGTU_DB_SLOW_MS=1000
XINGTU_TEMPORAL_ADDRESS=100.64.0.10:7233
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1

# If the approved production proxy requires authentication, reference these names from UnitConfig.
XINGTU_LINE_PROXY_USERNAME=CHANGE_ME
XINGTU_LINE_PROXY_PASSWORD=CHANGE_ME
