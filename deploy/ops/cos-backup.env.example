# chmod 600 after copying outside Git. COS uses its S3-compatible endpoint.
COS_ENDPOINT_URL=https://cos.CHANGE_ME_REGION.myqcloud.com
COS_BUCKET=CHANGE_ME_BACKUP_BUCKET
COS_PREFIX=yumeng-production
AWS_ACCESS_KEY_ID=CHANGE_ME_COS_SECRET_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_COS_SECRET_KEY
AWS_DEFAULT_REGION=CHANGE_ME_REGION
# MinIO source is reachable only on the server/Tailscale interface.
MINIO_ENDPOINT=http://100.64.0.10:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=xingtu-covers
