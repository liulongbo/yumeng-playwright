# Compose interpolation only. Copy to deploy/single-node.env, chmod 600.
# The application containers do not receive this file, so infrastructure root credentials stay
# out of the app processes; they read deploy/single-node.application.env instead.
APP_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
TEMPORAL_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
MINIO_ROOT_USER=xingtu_baseline
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM
MINIO_WORKER_USER=xingtu_worker
MINIO_WORKER_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM

XINGTU_APP_IMAGE=xingtu-app:baseline
XINGTU_WEB_IMAGE=xingtu-web:baseline
XINGTU_WORKER_IMAGE=xingtu-worker:baseline
XINGTU_ENV_FILE=./single-node.application.env
UNIT_CONFIG_FILE=./units/unit-server-01.json

# Only the web port faces the public internet; the API stays on host loopback.
WEB_BIND_PORT=18080
API_BIND_PORT=18000

# Build acceleration for servers behind the Great Firewall.
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.cloud.tencent.com

# Guardrails. Tune only from measured `docker stats` and host memory pressure.
APP_POSTGRES_MEMORY_LIMIT=384m
TEMPORAL_POSTGRES_MEMORY_LIMIT=384m
TEMPORAL_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=128m
MINIO_MEMORY_LIMIT=384m
MIGRATION_MEMORY_LIMIT=384m
API_MEMORY_LIMIT=320m
WEB_MEMORY_LIMIT=64m
INTAKE_MEMORY_LIMIT=512m
SCHEDULER_MEMORY_LIMIT=256m
WORKER_MEMORY_LIMIT=768m
